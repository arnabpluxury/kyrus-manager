{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyrus Manager",
  "version": "0.2.0",
  "identifier": "com.kyrus.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kyrus Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "publisher": "Kyrus",
    "copyright": "Copyright © Kyrus",
    "category": "Utility",
    "shortDescription": "Windows system control center",
    "longDescription": "Kyrus Manager — storage analysis, process control, firewall, scheduler, GPU, and Control Panel launchers for Windows."
  }
}
